# Copia este archivo como .env.local y rellena los valores
# .env.local está en .gitignore — nunca subas tus keys reales

# OpenWeatherMap — tiles del mapa (capa viento, nubes, etc.)
# Gratis, 1,000 calls/día · https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# NASA APOD — foto astronómica del día
# Gratis, 1,000 calls/día · https://api.nasa.gov
# Si se omite, usa DEMO_KEY automáticamente (límite más bajo)
NASA_API_KEY=
